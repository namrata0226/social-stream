PORT=8000
CORS_ORIGIN=http://localhost:5173

# Leave empty to use a built-in local MongoDB (data saved in backend/data/db).
# For Atlas or your own server, e.g. mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=

ACCESS_TOKEN_SECRET=change-me-access-secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=change-me-refresh-secret
REFRESH_TOKEN_EXPIRY=10d

# Optional: set all three to store uploads on Cloudinary instead of backend/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Max upload size in MB
MAX_UPLOAD_MB=1024
